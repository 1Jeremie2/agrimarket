# Base de données (Neon → dashboard du projet > Connection Details > Connection string)
# Utiliser la chaîne "Pooled connection" en production pour éviter d'épuiser
# les connexions directes sur le plan gratuit.
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/[database]?sslmode=require"

# Connexion DIRECTE (sans "-pooler" dans l'URL) — nécessaire uniquement pour
# les migrations Prisma (npx prisma migrate dev), qui ne fonctionnent pas
# correctement via la connexion poolée sur Neon.
DIRECT_URL="postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require"

# Authentification
JWT_SECRET="change-moi-en-production"
JWT_EXPIRES_IN="7d"

# Cloudflare R2 (stockage photos produits + preuves de paiement)
# R2_ACCOUNT_ID : Cloudflare dashboard > R2 > Overview (dans l'URL du compte)
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY : R2 > Manage API Tokens > Create API Token
# R2_PUBLIC_URL : l'URL publique du bucket (domaine personnalisé ou r2.dev activé)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="agri-marketplace-media"
R2_PUBLIC_URL="https://media.tondomaine.com"

# FedaPay — non utilisé actuellement (voir README, section "Paiement" :
# le MVP utilise un système de paiement par référence manuel). Conservé au cas
# où une automatisation future serait ajoutée.
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_SECRET_KEY=""
FEDAPAY_ENV="sandbox"

# App
PORT=3001
FRONTEND_URL="http://localhost:3000"
